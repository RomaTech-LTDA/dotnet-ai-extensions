<Project>
  <PropertyGroup>
    <Version>4.0.0</Version>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NETSDK1138;NU1510;CS1591</NoWarn>
    <Authors>Romatech</Authors>
    <Company>Romatech</Company>
    <RepositoryUrl>https://github.com/RomaTech-LTDA/dotnet-ai-extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>    
    <PackageProjectUrl>https://github.com/RomaTech-LTDA/dotnet-ai-extensions</PackageProjectUrl>
    <Copyright>Copyright (c) Romatech 2025</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>
      ai;
      llm;
      rag;
      mcp;
      swagger;
      openapi;
      aspnetcore;
      semantic-search;
      ai-tools
    </PackageTags>
    <Description>
      Plug-and-play AI enablement framework for ASP.NET Core applications with MCP and RAG support.
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)logo.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Source Link is built into the .NET 8+ SDK; no package reference needed. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Fail restore on any known vulnerability in direct or transitive packages. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
</Project>
