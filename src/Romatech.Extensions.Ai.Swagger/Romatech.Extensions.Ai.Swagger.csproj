<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Romatech.Extensions.Ai.Swagger</PackageId>
    <Description>In-process endpoint discovery (ApiExplorer + endpoint metadata) and JSON Schema generation for Romatech.Extensions.Ai. Works with any OpenAPI generator (Swashbuckle, Microsoft.AspNetCore.OpenApi, NSwag, Scalar) or none; never downloads the OpenAPI document.</Description>
    <PackageTags>ai;mcp;rag;aspnetcore;openapi;apiexplorer;json-schema</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Romatech.Extensions.Ai.Shared\Romatech.Extensions.Ai.Shared.csproj" />
    <ProjectReference Include="..\Romatech.Extensions.Ai.Metadata\Romatech.Extensions.Ai.Metadata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Romatech.Extensions.Ai.Tests" />
  </ItemGroup>

</Project>
